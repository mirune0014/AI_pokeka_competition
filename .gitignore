# Local generated-output quarantine and malformed legacy evaluation paths.
/_local_generated/
**/analysis_outputs/
/archaludonevaluations*/

# Local desktop-app build and self-test outputs. Keep src/, tests/, packaging,
# pyproject.toml, README.md, QML sources, and authored assets tracked.
infrastructure/apps/ptcg_desktop/build*/
infrastructure/apps/ptcg_desktop/dist*/
infrastructure/apps/ptcg_desktop/selftest-current.*

# Generated distributables and regenerable visualizer card-image assets.
infrastructure/tools/ptcg_japanese_visualizer_extension/assets/
infrastructure/tools/ptcg_japanese_visualizer_extension/_metadata/

# Staged Alakazam execution output. Keep versions/, specs/, fixtures/,
# eval_adapters/, reports/, diagnostics/, and source scripts trackable.
alakazam/evaluations/
alakazam/metrics/
alakazam/metric_smoke/
alakazam/submissions/
alakazam/probe_trace/
alakazam/probe_direct_mirror_trace/
alakazam/equivalence/
alakazam/first_divergence/
# Historical package snapshots and probe output are rebuilt from each frozen
# version. Keep the policy source, tests, runtime entry point, and deck tracked.
alakazam/versions/*/frozen_submission/
alakazam/versions/*/verification/c2_action_identity_probe*.json
alakazam/diagnostics/**/console.txt

# Root-level metric runs are reproducible execution output.
/metrics/

# Large derived analysis tables; compact reports and their generator scripts
# remain tracked.
/research/reports/winner_loser_action_diff.csv
/research/reports/opening_sequence_patterns.csv

# Raw Kaggle and replay data
infrastructure/data/episodes*/
infrastructure/data/leaderboard_*/
infrastructure/data/episodes_index*/
infrastructure/external/ptcg_engine/
infrastructure/external/ptcg_engine.zip

# Raw replay JSON from submission-specific analysis. Keep compact Markdown/CSV
# summaries and telemetry under the analysis directory trackable.
/autonomous_gold_20260715/analysis/archaludon_submission_55248159_20260809/*.json

# Autonomous-loop raw state. Keep source, Markdown, CSV, and text evidence.
archaludon/**/*.json
# These JSON files are authored reproducibility contracts/compact strategy
# inputs rather than raw episode output.
!archaludon/evaluation_specs/**/*.json
!archaludon/strategy/**/*.json
*.whl

# Autonomous-loop reproducible intermediates. Canonical candidates and decisions remain tracked.
archaludon/analysis/
archaludon/audits/
archaludon/evaluations/
archaludon/evidence/
archaludon/implementation/
archaludon/live/
archaludon/packages/
