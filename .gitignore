# Large raw diagnostic/evaluation expansions. Keep their compact verdicts,
# comparison specifications, and recomputation scripts trackable.
archaludon/root_verification/**/*_raw*/
archaludon/root_verification/**/throwaway_traces/
archaludon/root_verification/**/summaries/
archaludon/comparisons/**/*_raw*/
archaludon/strategy/**/*_raw/

# Root-verification result tables and console captures are regenerated by the
# adjacent checked scripts. Keep provenance inputs and diagnostic agent decks.
archaludon/root_verification/**/*.csv
!archaludon/root_verification/**/*source_manifest.csv
!archaludon/root_verification/**/input_hashes.csv
!archaludon/root_verification/**/diagnostic_v2/deck.csv
archaludon/root_verification/**/*.diff
archaludon/root_verification/**/*stdout.txt
archaludon/root_verification/**/*stderr.txt
archaludon/root_verification/**/console.txt
archaludon/comparisons/**/*.csv
